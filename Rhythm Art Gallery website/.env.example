# Copy to .env (never commit .env). Real values stay local / in Vercel settings.

# PostgreSQL on Neon. Copy the connection string from the Neon dashboard (Connect -> use the direct,
# non-pooled string for migrations). Keep ?sslmode=require. Never commit the real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js
AUTH_SECRET=""            # generate: npx auth secret
AUTH_URL="http://localhost:3000"

# Razorpay (TEST keys only until shop KYC is done)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""   # same as KEY_ID; safe to expose

# Cloudinary (later, when images move off local folder)
CLOUDINARY_URL=""
